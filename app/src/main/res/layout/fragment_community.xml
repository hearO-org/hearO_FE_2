<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hearo_bg">

    <ScrollView
        android:id="@+id/scrollArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 🔹 상단 헤더 -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RelativeLayout
                    android:id="@+id/topHeader"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:padding="20dp"
                    android:background="@drawable/home_header_bg">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/imgProfile"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_profile_placeholder"
                            android:background="@drawable/profile_circle"
                            android:scaleType="centerCrop"/>

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:id="@+id/tvUserName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="hearO"
                                android:textColor="@android:color/white"
                                android:textSize="16sp"
                                android:textStyle="bold"/>


                        </LinearLayout>
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true">

                        <ImageView
                            android:id="@+id/btnAlarm"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_alarm"
                            android:layout_marginTop="5dp"/>


                    </FrameLayout>
                </RelativeLayout>

                <!-- 2단 헤더 -->
                <LinearLayout
                    android:id="@+id/soundHeader"
                    android:orientation="vertical"
                    android:background="@android:color/white"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="커뮤니티"
                        android:textColor="#222222"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="함께 만드는 지식 공간"
                        android:textColor="#666666"
                        android:textSize="13sp"
                        android:layout_marginTop="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 검색창 -->
            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="15dp"
                android:layout_marginHorizontal="20dp"
                android:hint="게시판 제목을 검색하세요..."
                android:background="@drawable/search_box_bg"
                android:paddingHorizontal="15dp"
                android:textSize="14sp"/>


            <!-- 탭 -->
            <!-- 🔹 카테고리 탭 (가로 스크롤) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingHorizontal="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="15dp">

                    <TextView
                        android:id="@+id/tabAll"
                        style="@style/TabChipStyle"
                        android:text="전체"/>

                    <TextView
                        android:id="@+id/tabGeneral"
                        style="@style/TabChipStyle"
                        android:text="일반"/>

                    <TextView
                        android:id="@+id/tabQuestion"
                        style="@style/TabChipStyle"
                        android:text="질문"/>

                    <TextView
                        android:id="@+id/tabReview"
                        style="@style/TabChipStyle"
                        android:text="후기"/>

                    <TextView
                        android:id="@+id/tabSign"
                        style="@style/TabChipStyle"
                        android:text="수어학습정보"/>

                    <TextView
                        android:id="@+id/tabSafety"
                        style="@style/TabChipStyle"
                        android:text="안전/대처"/>

                    <TextView
                        android:id="@+id/tabPolicy"
                        style="@style/TabChipStyle"
                        android:text="정책/지원"/>

                    <TextView
                        android:id="@+id/tabJob"
                        style="@style/TabChipStyle"
                        android:text="취업/교육"/>

                </LinearLayout>
            </HorizontalScrollView>



            <!-- 🔥 RecyclerView 영역 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingBottom="120dp"
                android:clipToPadding="false" />

        </LinearLayout>
    </ScrollView>

    <!-- 🔥 글쓰기 Floating Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabWrite"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="20dp"
        android:src="@drawable/ic_edit"
        app:tint="@android:color/white"
        app:backgroundTint="#6F56F5" />

</RelativeLayout>
