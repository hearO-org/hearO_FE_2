<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="24dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 제목 -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="닉네임"
            android:textColor="#333333"
            android:textSize="15sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 닉네임 입력 -->
        <EditText
            android:id="@+id/etNickname"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:hint="username"
            android:background="@drawable/edittext_bg"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 성별 -->
        <TextView
            android:id="@+id/tvGenderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="성별"
            android:layout_marginTop="24dp"
            android:textColor="#333333"
            app:layout_constraintTop_toBottomOf="@id/etNickname"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 성별 선택 박스 -->
        <LinearLayout
            android:id="@+id/layoutGender"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="@drawable/selector_box"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/tvGenderTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/btnMale"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:layout_weight="1"
                android:text="남성"
                android:textColor="#666666"
                android:textSize="14sp"
                android:background="@drawable/gender_unselected" />

            <TextView
                android:id="@+id/btnFemale"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="여성"
                android:layout_weight="1"
                android:textColor="#666666"
                android:textSize="14sp"
                android:background="@drawable/gender_unselected" />
        </LinearLayout>

        <!-- 생년월일 -->
        <TextView
            android:id="@+id/tvBirth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="년     월     일"
            android:textColor="#333333"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/layoutGender"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Spinner 3개 -->
        <LinearLayout
            android:id="@+id/layoutBirth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvBirth"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Spinner
                android:id="@+id/spinnerYear"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"/>

            <Spinner
                android:id="@+id/spinnerMonth"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"/>

            <Spinner
                android:id="@+id/spinnerDay"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"/>
        </LinearLayout>

        <!-- 직업 키워드 -->
        <LinearLayout
            android:id="@+id/layoutJobKeyword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/layoutBirth">

            <TextView
                android:id="@+id/keyword1"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="가족/보호자"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:background="@drawable/keyword_unselected"
                android:textColor="#666666"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/keyword2"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="청각장애인"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:background="@drawable/keyword_unselected"
                android:textColor="#666666"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/keyword3"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="사회복지사"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:background="@drawable/keyword_unselected"
                android:textColor="#666666"/>
        </LinearLayout>

        <!-- 다음 버튼 -->
        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:text="다음"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#A78BFA"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/layoutJobKeyword"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
