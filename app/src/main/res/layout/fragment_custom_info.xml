<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hearo_bg">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ========================================= -->
        <!-- ① 상단 보라색 헤더 영역 (프로필 + 알림) -->
        <!-- ========================================= -->
        <RelativeLayout
            android:id="@+id/topHeader"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:padding="20dp"
            android:background="@drawable/home_header_bg">

            <!-- 프로필 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imgProfile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_profile_placeholder"
                    android:background="@drawable/profile_circle"
                    android:scaleType="centerCrop"/>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="hearO"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"/>


                </LinearLayout>
            </LinearLayout>

            <!-- 알림 -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true">

                <ImageView
                    android:id="@+id/btnAlarm"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_alarm"
                    android:layout_marginTop="3dp"/>

            </FrameLayout>
        </RelativeLayout>


        <!-- ========================================= -->
        <!-- ② 하얀 헤더(소리 인식 텍스트) -->
        <!-- ========================================= -->
        <LinearLayout
            android:id="@+id/soundHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="20dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="구인 정보"
                android:textColor="#222222"
                android:textStyle="bold"
                android:textSize="20sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="AI 기반 정보 허브 "
                android:textColor="#666666"
                android:textSize="13sp"/>
        </LinearLayout>


        <!-- ========================================= -->
        <!-- ③ 실시간 구인 정보 제목 -->
        <!-- ========================================= -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:gravity="center_vertical">

            <TextView
                android:text="실시간 구인 정보"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

        </LinearLayout>


        <!-- ========================================= -->
        <!-- ④ 구인 정보 검색창 -->
        <!-- ========================================= -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/search_box_bg">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"/>

            <EditText
                android:id="@+id/etJobSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="직종, 회사명으로 검색하세요..."
                android:paddingStart="10dp"
                android:background="@android:color/transparent"/>

        </LinearLayout>


        <!-- ========================================= -->
        <!-- ⑤ 직종 탭 -->
        <!-- ========================================= -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:scrollbars="none">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tabAll"
                    style="@style/JobTab"
                    android:text="전체"/>

                <TextView
                    android:id="@+id/tabContract"
                    style="@style/JobTab"
                    android:text="계약직" />

                <TextView
                    android:id="@+id/tabPermanent"
                    style="@style/JobTab"
                    android:text="상용직" />

                <TextView
                    android:id="@+id/tabPartTime"
                    style="@style/JobTab"
                    android:text="시간제" />



            </LinearLayout>
        </HorizontalScrollView>


        <!-- ========================================= -->
        <!-- ⑥ 구인 정보 리스트 -->
        <!-- ========================================= -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvJobs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"/>
    </LinearLayout>
</ScrollView>
