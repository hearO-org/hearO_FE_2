<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hearo_bg">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ======================================================= -->
        <!-- ① 상단 헤더 -->
        <!-- ======================================================= -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:id="@+id/topHeader"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:padding="20dp"
                android:background="@drawable/home_header_bg">

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/imgProfileTop"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_profile_placeholder"
                        android:background="@drawable/profile_circle"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp">

                        <!-- 닉네임만 유지 -->
                        <TextView
                            android:id="@+id/tvUserNameTop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="hearO"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- user 상태는 API에 없음 → 제거 or GONE -->
                        <TextView
                            android:id="@+id/tvUserStateTop"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#F1F1F1"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 알림 배지 : API 없음 → 기본 GONE -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true">

                    <ImageView
                        android:id="@+id/btnAlarm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:src="@drawable/ic_alarm" />

                    <TextView
                        android:id="@+id/tvAlarmBadge"
                        android:visibility="gone"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/badge_circle_red"
                        android:text=""
                        android:gravity="center"
                        android:textColor="@android:color/white"
                        android:textSize="10sp" />
                </FrameLayout>
            </RelativeLayout>

            <!-- 하얀 헤더 -->
            <LinearLayout
                android:id="@+id/whiteHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="20dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="마이페이지"
                    android:textColor="#222222"
                    android:textStyle="bold"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="계정 설정과 활동 내역을 확인하세요"
                    android:textColor="#666666"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>


        <!-- ======================================================= -->
        <!-- ② 프로필 카드 -->
        <!-- ======================================================= -->
        <androidx.cardview.widget.CardView
            android:id="@+id/boxBasicInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/imgProfile"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:src="@drawable/ic_profile_placeholder"
                    android:background="@drawable/profile_circle"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_marginStart="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <!-- 닉네임 -->
                    <TextView
                        android:id="@+id/tvNickname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="user"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#222" />



                    <!-- 이메일 -->
                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="user@hearo.com"
                        android:textSize="13sp"
                        android:textColor="#666" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnEditProfile"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="110dp"
                    android:src="@drawable/ic_edit" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <!-- ======================================================= -->
        <!-- ③ 내 활동 → 전체 보기 -->
        <!-- ======================================================= -->
        <androidx.cardview.widget.CardView
            android:id="@+id/boxMyActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="15dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:orientation="vertical"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="내 활동"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#333"
                    android:layout_marginBottom="10dp" />

                <!-- 여기 누르면 MyActivityFragment 로 이동 -->
                <TextView
                    android:id="@+id/menuMyActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="내 활동 전체 보기"
                    android:textSize="14sp"
                    android:textColor="#555"
                    android:paddingVertical="12dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <!-- ======================================================= -->
        <!-- ④ 설정 영역 -->
        <!-- ======================================================= -->
        <androidx.cardview.widget.CardView
            android:id="@+id/boxAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="15dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:orientation="vertical"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="설정"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#333"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/menuAlarm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="알림 설정"
                    android:textSize="14sp"
                    android:textColor="#555"
                    android:paddingVertical="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EFEFEF" />

                <TextView
                    android:id="@+id/menuLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="로그아웃"
                    android:textSize="14sp"
                    android:textColor="#555"
                    android:paddingVertical="12dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <!-- ======================================================= -->
        <!-- ⑤ 기타 영역 -->
        <!-- ======================================================= -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:orientation="vertical"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/menuNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="공지사항"
                    android:textSize="14sp"
                    android:textColor="#555"
                    android:paddingVertical="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EFEFEF" />

                <TextView
                    android:id="@+id/menuPrivacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="개인정보 처리방침"
                    android:textSize="14sp"
                    android:textColor="#555"
                    android:paddingVertical="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EFEFEF" />

                <TextView
                    android:id="@+id/menuTerms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="서비스 이용약관"
                    android:textSize="14sp"
                    android:textColor="#555"
                    android:paddingVertical="12dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
