<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:background="@android:color/white">

        <!-- 제목 -->
        <TextView
            android:id="@+id/tvTermsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="약관에 동의해주세요"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="150dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 설명 -->
        <TextView
            android:id="@+id/tvTermsDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="어플을 사용하기 위해 필요한 절차입니다"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTermsTitle"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 전체 동의 -->
        <CheckBox
            android:id="@+id/chkAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="전체 동의"
            android:textSize="16sp"
            android:textColor="#333333"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvTermsDesc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 이용약관 체크 -->
        <CheckBox
            android:id="@+id/chkTerms"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="이용약관 동의 (필수)"
            android:textSize="15sp"
            android:textColor="#333333"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/chkAll"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 개인정보 동의 체크 -->
        <CheckBox
            android:id="@+id/chkPrivacy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="개인정보 수집·이용 동의 (필수)"
            android:textSize="15sp"
            android:textColor="#333333"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/chkTerms"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 다음 버튼 -->
        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:text="다음"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#C4B5FD"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toBottomOf="@id/chkPrivacy"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
