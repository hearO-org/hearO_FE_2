<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:background="@android:color/white">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="관심 키워드를 선택해주세요"
            android:textSize="18sp"
            android:textColor="#333333"
            android:layout_marginTop="150dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/btnKeyword1"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="취업"
            android:gravity="center"
            android:background="@drawable/keyword_unselected"
            android:textColor="#888888"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnKeyword2" />

        <TextView
            android:id="@+id/btnKeyword2"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="복지"
            android:gravity="center"
            android:background="@drawable/keyword_unselected"
            android:textColor="#888888"
            android:layout_marginTop="20dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toEndOf="@id/btnKeyword1"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/btnKeyword3"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="생활정보"
            android:gravity="center"
            android:background="@drawable/keyword_unselected"
            android:textColor="#888888"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toBottomOf="@id/btnKeyword1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnKeyword4" />

        <TextView
            android:id="@+id/btnKeyword4"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="모임·커뮤니티"
            android:gravity="center"
            android:background="@drawable/keyword_unselected"
            android:textColor="#888888"
            android:layout_marginTop="12dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toBottomOf="@id/btnKeyword2"
            app:layout_constraintStart_toEndOf="@id/btnKeyword3"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/btnKeyword5"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="교육"
            android:gravity="center"
            android:background="@drawable/keyword_unselected"
            android:textColor="#888888"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toBottomOf="@id/btnKeyword3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnKeyword6" />

        <TextView
            android:id="@+id/btnKeyword6"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="보조공학·기술"
            android:gravity="center"
            android:background="@drawable/keyword_unselected"
            android:textColor="#888888"
            android:layout_marginTop="12dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toBottomOf="@id/btnKeyword4"
            app:layout_constraintStart_toEndOf="@id/btnKeyword5"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/btnKeyword7"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="취미·여가"
            android:gravity="center"
            android:background="@drawable/keyword_unselected"
            android:textColor="#888888"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toBottomOf="@id/btnKeyword5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnKeyword8" />

        <TextView
            android:id="@+id/btnKeyword8"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="자막·영상콘텐츠"
            android:gravity="center"
            android:background="@drawable/keyword_unselected"
            android:textColor="#888888"
            android:layout_marginTop="12dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toBottomOf="@id/btnKeyword6"
            app:layout_constraintStart_toEndOf="@id/btnKeyword7"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnFinish"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:text="완료"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:backgroundTint="#A78BFA"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/btnKeyword8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
