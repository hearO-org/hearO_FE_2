<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- 프로필 -->
    <ImageView
        android:id="@+id/imgReplyProfile"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/ic_profile_placeholder"
        android:background="@drawable/profile_circle"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content">

        <!-- 이름 + 배지 -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvWriter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="청각전문가"
                android:textColor="#222"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvReplyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:padding="4dp"
                android:text="인증회원"
                android:background="@drawable/tag_small_bg"
                android:textColor="#6F56F5"
                android:textSize="10sp"/>
        </LinearLayout>

        <!-- 시간 -->
        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1시간 전"
            android:textColor="#888"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />

        <!-- 댓글 내용 -->
        <TextView
            android:id="@+id/tvComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="여기에 댓글 내용이 들어갑니다."
            android:textColor="#333"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp" />

        <!-- 좋아요 + 답글 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/ic_heart_empty"
                android:layout_width="16dp"
                android:layout_height="16dp" />

            <TextView
                android:id="@+id/tvReplyLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textColor="#666"
                android:textSize="12sp"
                android:layout_marginStart="4dp" />

            <TextView
                android:id="@+id/btnReplyDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="답글"
                android:textColor="#666"
                android:textSize="12sp"
                android:layout_marginStart="20dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
