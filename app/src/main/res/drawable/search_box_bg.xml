<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 배경색 (흰색) -->
    <solid android:color="#FFFFFF" />

    <!-- 둥근 모서리 -->
    <corners android:radius="14dp" />

    <!-- 아주 옅은 테두리 -->
    <stroke
        android:width="1dp"
        android:color="#E5E5E5" />

    <!-- 내부 여백 -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp" />

</shape>
